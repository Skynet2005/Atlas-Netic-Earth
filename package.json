{
  "name": "atlas-netic",
  "version": "0.2.3",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "models": "node scripts/build-traffic-models.mjs && node scripts/build-satellite-models.mjs",
    "dev": "pnpm models && node scripts/prepare-globe.mjs && next dev",
    "build": "pnpm models && node scripts/prepare-globe.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "perf": "node scripts/perf-budget.mjs",
    "verify": "pnpm lint && pnpm test && pnpm audit:deps && pnpm perf && pnpm build",
    "audit:deps": "node scripts/dependency-audit.mjs",
    "e2e": "playwright test -c playwright.config.mjs"
  },
  "dependencies": {
    "cesium": "1.137.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
