# Optional wider maritime reception. Keep server-side only.
AISSTREAM_API_KEY=

# Optional NASA FIRMS near-real-time thermal detections.
# Without this, Atlas-Netic automatically falls back to NASA EONET wildfire events.
FIRMS_MAP_KEY=

# Ground directions and geocoding through the current HeiGIT openrouteservice API.
# Keep server-side; required for place-name routing and toll/highway/ferry avoidance.
OPENROUTESERVICE_API_KEY=

# FAA NOTAM Management Service distribution API.
# Access/documentation must be requested from the FAA. The URL must contain
# a {location} placeholder, for example the location query in your approved NMS endpoint.
FAA_NMS_API_URL=
FAA_NMS_API_KEY=
FAA_NMS_API_KEY_HEADER=X-API-Key
